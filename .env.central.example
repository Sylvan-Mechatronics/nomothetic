# nomothetic central mode environment variables
# Copy to .env.central: cp .env.central.example .env.central
# .env.central is gitignored — never commit secrets or credentials here.

# =============================================================================
# Deployment (scripts/deploy.sh --mode central)
# =============================================================================

# SSH target for the central server — "user@hostname" or plain IP.
# NOMON_PI_HOST=user@central-server.example.com
NOMON_PI_HOST=

# Optional path to an SSH private key.
# NOMON_SSH_KEY=~/.ssh/id_ed25519
NOMON_SSH_KEY=

# Optional sudo password for non-interactive remote sudo.
# NOMON_SUDO_PASS=
NOMON_SUDO_PASS=

# Optional absolute path to the nomothetic repo on the remote server.
# NOMON_REMOTE_DIR=/home/user/perceptua-nomon/nomothetic

# Service user / group for systemd service units.
# NOMON_SERVICE_USER=nomon
# NOMON_SERVICE_GROUP=nomon

# =============================================================================
# API Mode
# =============================================================================

NOMON_API_MODE=central

# =============================================================================
# Authentication (central mode only)
# =============================================================================

# Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# NOMON_JWT_SECRET=
NOMON_JWT_SECRET=

# Registration invite code (review finding S-5). While email verification is
# not implemented, set this so only people holding the code can create central
# accounts; clients send it as "invite_code" on POST /api/auth/register. Unset =
# open registration (development only).
# NOMON_REGISTRATION_INVITE_CODE=

# Refuse device registrations that carry no verifiable device identity key
# (review S-3). Leave unset only while devices still run builds that do not
# publish device_public_key; those fall back to the legacy structural proof
# (logged as a warning).
# NOMON_FLEET_REQUIRE_DEVICE_KEY=1

# =============================================================================
# ArcadeDB (central mode only)
# =============================================================================

# Omit ARCADEDB_HOST to use in-memory stores (dev/test).
# ARCADEDB_HOST=localhost
# ARCADEDB_HTTP_PORT=2480
# ARCADEDB_DATABASE=nomon_central
# Quote passwords containing shell special characters (& ! $ etc.).
# ARCADEDB_ROOT_PASSWORD='changeme_before_deploy'
# ARCADEDB_USE_TLS=false

# =============================================================================
# CORS
# =============================================================================

# Comma-separated allowed origins.
# NOMON_CORS_ORIGINS=http://localhost:8081

# =============================================================================
# TLS Certificate
# =============================================================================

# Additional hostnames/IPs in the self-signed cert's SAN list.
# NOMON_TLS_EXTRA_HOSTS=myhost.example.com

# =============================================================================
# Reverse Proxy
# =============================================================================

# Set to "true" to trust X-Forwarded-For headers for rate limiting.
# NOMON_TRUST_PROXY=false

# =============================================================================
# MQTT Telemetry Ingestion (central consumer)
# =============================================================================

# NOMON_MQTT_BROKER=
# NOMON_MQTT_PORT=1883
# NOMON_MQTT_TOPIC=nomon/telemetry
# NOMON_MQTT_AUTONOMY_TOPIC=nomon/autonomy
# Broker credentials and TLS (review finding S-4). Without these the link is
# plaintext and unauthenticated, and anyone reaching the broker can inject
# telemetry or autonomy events for any device. Set NOMON_MQTT_TLS=1 to use the
# system CA bundle (port defaults to 8883), or NOMON_MQTT_CA_CERT for a private
# broker CA. Give each device its own username with a topic ACL on the broker.
# NOMON_MQTT_USERNAME=
# NOMON_MQTT_PASSWORD=
# NOMON_MQTT_TLS=1
# NOMON_MQTT_CA_CERT=/etc/nomothetic/mqtt-ca.pem
