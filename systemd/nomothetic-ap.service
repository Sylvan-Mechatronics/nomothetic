[Unit]
Description=nomon REST API server (Soft AP mode, HTTP on 192.168.4.1:8080)
After=network.target nomopractic.service
Wants=nomopractic.service

[Service]
Type=simple
# ${NOMON_SERVICE_USER}, ${NOMON_SERVICE_GROUP}, and ${NOMON_INSTALL_DIR} are
# template variables expanded by envsubst at deploy time (scripts/deploy.sh).
# The installed /etc/systemd/system/ file contains the literal resolved values,
# e.g. User=nomon — systemd never sees the $ placeholders.
# To override, set NOMON_SERVICE_USER / NOMON_SERVICE_GROUP in your local .env.
User=${NOMON_SERVICE_USER}
Group=${NOMON_SERVICE_GROUP}
EnvironmentFile=-/etc/nomothetic/nomothetic.env

# systemd creates /var/lib/nomon owned by User:Group automatically.
StateDirectory=nomon
RuntimeDirectory=nomothetic-ap
RuntimeDirectoryMode=0755

WorkingDirectory=${NOMON_INSTALL_DIR}

# Plain HTTP on 192.168.4.1:8080.  Binding to the AP gateway IP ensures the
# AP API is unreachable from other network interfaces.  Cleartext is
# acceptable: the AP is a closed WPA2 hotspot on an isolated 192.168.4.0/24
# subnet (ADR-016).
ExecStart=${NOMON_INSTALL_DIR}/.venv/bin/uvicorn nomothetic.api:create_app --factory \
  --host 192.168.4.1 --port 8080

Environment=NOMON_API_MODE=device
Environment=NOMON_DEVICE_AUTH=true
Environment=NOMON_AP_MODE_SCRIPT=/usr/local/bin/ap-mode.sh

# Sandboxing (review finding S-17). NoNewPrivileges is deliberately absent: the
# service calls sudo for the scoped ap-mode.sh systemctl rule. /var/lib/nomon,
# /run/nomothetic and the media dir stay writable; /usr, /boot, /etc are not.
ProtectSystem=full
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
RestrictSUIDSGID=true

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal
# No [Install] section — this service is not enabled at boot.
# It is started and stopped exclusively by ap-mode.sh when the Soft AP
# goes up or down (see nomothetic ADR-016).
