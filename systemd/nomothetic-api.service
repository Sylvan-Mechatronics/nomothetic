[Unit]
Description=nomon REST API server (device mode)
After=network.target nomopractic.service
Wants=nomopractic.service

[Service]
Type=simple
# ${NOMON_SERVICE_USER}, ${NOMON_SERVICE_GROUP}, and ${NOMON_INSTALL_DIR} are
# template variables expanded by envsubst at deploy time (scripts/deploy.sh).
# The installed /etc/systemd/system/ file contains the literal resolved values,
# e.g. User=nomon — systemd never sees the $ placeholders.
# To override, set NOMON_SERVICE_USER / NOMON_SERVICE_GROUP in your local .env.
User=${NOMON_SERVICE_USER}
Group=${NOMON_SERVICE_GROUP}
# /dev/snd access for the USB PCM2902 codec (mic + speaker): the wake-word
# listener (ADR-021) and the /api/audio/* record/play endpoints open ALSA
# devices through PyAudio.
SupplementaryGroups=audio
EnvironmentFile=-/etc/nomothetic/nomothetic.env

# systemd creates /var/lib/nomon owned by User:Group automatically.
StateDirectory=nomon
# /run/nomothetic is tmpfs; recreate on every start for the operator secret display.
RuntimeDirectory=nomothetic
RuntimeDirectoryMode=0755

WorkingDirectory=${NOMON_INSTALL_DIR}
ExecStart=${NOMON_INSTALL_DIR}/.venv/bin/uvicorn nomothetic.api:create_app --factory --host 0.0.0.0 --port 8443 \
  --ssl-keyfile /etc/nomothetic/tls/key.pem --ssl-certfile /etc/nomothetic/tls/cert.pem

Environment=NOMON_API_MODE=device
Environment=NOMON_DEVICE_AUTH=true
Environment=NOMON_AP_MODE_SCRIPT=/usr/local/bin/ap-mode.sh

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
